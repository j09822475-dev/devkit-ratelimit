    "@types/node": "^22.0.0",
    "@upstash/redis": "^1.34.0",
    "@vitest/coverage-v8": "^2.0.0",
    "elysia": "^1.1.0",
    "express": "^4.19.0",
    "fastify": "^4.28.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "ioredis-mock": "^8.9.0",
    "miniflare": "^3.20240925.0",
    "msw": "^2.4.0",
    "next": "^14.2.0",
    "publint": "^0.2.0",
    "size-limit": "^11.1.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
