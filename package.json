    },
    "./algorithms/sliding-window-log": {
      "types": "./dist/algorithms/sliding-window-log/index.d.ts",
      "import": "./dist/algorithms/sliding-window-log/index.js"
    },
    "./algorithms/token-bucket": {
      "types": "./dist/algorithms/token-bucket/index.d.ts",
      "import": "./dist/algorithms/token-bucket/index.js"
    },
    "./algorithms/fixed-window": {
      "types": "./dist/algorithms/fixed-window/index.d.ts",
      "import": "./dist/algorithms/fixed-window/index.js"
    },
    "./algorithms/leaky-bucket": {
      "types": "./dist/algorithms/leaky-bucket/index.d.ts",
