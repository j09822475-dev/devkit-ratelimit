{
  "name": "@devkit/ratelimit",
  "version": "0.1.0",
  "description": "Universal, zero-dependency, edge-runtime-native rate limiter on Web Standard Request/Response. ~6KB core, runs in Node 20+, Bun, Deno, Cloudflare Workers and Vercel Edge. Five algorithms (sliding window, sliding window log, token bucket, fixed window, leaky bucket), six storage adapters (memory, Redis, Upstash, Cloudflare KV/D1, Durable Objects), six framework adapters (Hono, Elysia, Express, Fastify, Next.js, SvelteKit). RFC-draft RateLimit-Policy headers from the box.",
  "license": "MIT",
  "author": "Mykhailo Kryvytskyi",
  "homepage": "https://github.com/j09822475-dev/devkit-ratelimit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j09822475-dev/devkit-ratelimit.git"
  },
  "bugs": {
    "url": "https://github.com/j09822475-dev/devkit-ratelimit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./algorithms/sliding-window": {
      "types": "./dist/algorithms/sliding-window/index.d.ts",
