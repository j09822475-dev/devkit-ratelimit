      "import": "./dist/adapters/memory/index.js"
    },
    "./adapters/redis": {
      "types": "./dist/adapters/redis/index.d.ts",
      "import": "./dist/adapters/redis/index.js"
    },
    "./adapters/upstash": {
      "types": "./dist/adapters/upstash/index.d.ts",
      "import": "./dist/adapters/upstash/index.js"
    },
    "./adapters/cloudflare-kv": {
      "types": "./dist/adapters/cloudflare-kv/index.d.ts",
      "import": "./dist/adapters/cloudflare-kv/index.js"
    },
    "./adapters/cloudflare-d1": {
      "types": "./dist/adapters/cloudflare-d1/index.d.ts",
      "import": "./dist/adapters/cloudflare-d1/index.js"
    },
    "./adapters/durable-object": {
      "types": "./dist/adapters/durable-object/index.d.ts",
      "import": "./dist/adapters/durable-object/index.js"
    },
    "./frameworks/hono": {
      "types": "./dist/frameworks/hono/index.d.ts",
      "import": "./dist/frameworks/hono/index.js"
    },
    "./frameworks/elysia": {
      "types": "./dist/frameworks/elysia/index.d.ts",
      "import": "./dist/frameworks/elysia/index.js"
    },
    "./frameworks/express": {
      "types": "./dist/frameworks/express/index.d.ts",
      "import": "./dist/frameworks/express/index.js"
    },
    "./frameworks/fastify": {
      "types": "./dist/frameworks/fastify/index.d.ts",
      "import": "./dist/frameworks/fastify/index.js"
    },
    "./frameworks/next": {
      "types": "./dist/frameworks/next/index.d.ts",
      "import": "./dist/frameworks/next/index.js"
    },
    "./frameworks/sveltekit": {
      "types": "./dist/frameworks/sveltekit/index.d.ts",
      "import": "./dist/frameworks/sveltekit/index.js"
    },
    "./compose": {
      "types": "./dist/compose/index.d.ts",
      "import": "./dist/compose/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ratelimit",
    "throttle",
    "throttling",
    "edge",
    "edge-runtime",
    "cloudflare-workers",
