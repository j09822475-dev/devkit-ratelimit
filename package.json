    "fixed-window",
    "ddos-protection",
    "api-security",
    "typescript",
    "type-safe",
    "zero-dependencies",
    "express-rate-limit-alternative",
    "upstash-ratelimit-alternative"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "publint": "publint",
    "attw": "attw --pack .",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run publint && npm run attw && npm run size"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2 <3",
    "@upstash/redis": ">=1.34 <2",
    "elysia": ">=1.1 <2",
    "express": ">=4 <6",
    "fastify": ">=4 <6",
    "hono": ">=4 <5",
    "next": ">=13.4 <16"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "@upstash/redis": {
